# Skopiuj do .env i dostosuj wartości (plik .env jest w .gitignore).
# Używane przez docker compose oraz python-dotenv przy uruchomieniu lokalnym.

# development (domyślnie) | production
DJANGO_ENV=development

# Wymagane przy DJANGO_ENV=production. W dev opcjonalne (compose ma domyślny klucz).
DJANGO_SECRET_KEY=change-me

# Lista hostów po przecinku (wymagane w production)
# DJANGO_ALLOWED_HOSTS=api.example.com

# Originy dla aplikacji mobilnej (Expo) — po przecinku
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://10.0.2.2:8000
# CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Baza danych (docker compose ustawia Postgres dla serwisu web)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=nerd_gym_bros
# DB_USER=nerd
# DB_PASSWORD=nerd_password
# DB_HOST=db
# DB_PORT=5432

# Stripe — opcjonalne lokalnie, jeśli nie testujesz płatności
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
# Development domyślnie używa console backendu, więc maile pojawią się w logach aplikacji.
# Produkcja używa SMTP i wymaga przynajmniej DJANGO_DEFAULT_FROM_EMAIL oraz EMAIL_HOST.
# DJANGO_DEFAULT_FROM_EMAIL=Nerd Gym Bros <no-reply@example.com>
# DJANGO_SERVER_EMAIL=errors@example.com
# DJANGO_EMAIL_SUBJECT_PREFIX=[Nerd Gym Bros]
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10

# JWT / API throttling (opcjonalne, domyślne wartości w settings/base.py)
# DRF throttle rates: login 20/h, register 10/h, token_refresh 60/h per IP

# Tylko production (DJANGO_ENV=production)
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_PRELOAD=false
